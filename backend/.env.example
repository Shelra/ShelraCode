# Shelra backend. Copy to backend/.env (git-ignored) and never commit real values. Bun loads .env on start.
# Where each value lives in the Supabase dashboard: Project Settings -> API Keys, and the Connect dialog.

# Port to listen on (hosts such as Railway set PORT themselves).
PORT=3001

# Postgres, from the Connect dialog. On a host with IPv6 use the direct connection; on an IPv4-only host use
# the shared pooler in SESSION mode (port 5432). Keep ?sslmode=require: the server refuses a remote database
# without it. This string holds the database password: it is the backend's only privileged credential.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# The project URL and its PUBLISHABLE key (sb_publishable_...). Both are public: GET /v1/auth/config hands
# them to clients so they can sign in. The server refuses to start with a secret key here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Only for `bun run check:supabase` (the end-to-end check against the real project): creates and deletes a
# throwaway user through the Auth admin API. The server never reads it; leave it empty otherwise.
SUPABASE_SECRET_KEY=
