# Sign-in (Auth.js). Copy to .env.local — never commit real values.
# Secret used to sign the session cookie. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth app: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github (your domain in production)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client (Web application): https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (your domain in production)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email + password users live in a libSQL database. In development the default is a local file
# (.data/auth.db, created automatically). In production point it at a libSQL/Turso database:
# https://turso.tech (free tier) → URL libsql://<name>-<org>.turso.io + auth token.
AUTH_DATABASE_URL=
AUTH_DATABASE_TOKEN=

# Outside Vercel (behind a trusted reverse proxy) also set:
# AUTH_TRUST_HOST=true
# AUTH_URL=https://your-domain.com
