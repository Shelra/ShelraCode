# Copy to .env.local — never commit real values.

# The web app (sign-in, account, demo dashboard) is hidden: its routes answer 404 and the navbar has no account
# entry (src/lib/features.ts). Set to 1 to build with it, e.g. to work on those pages locally.
# NEXT_PUBLIC_SHELRA_APP=1

# The navbar's GitHub star count reads the public API without a token (60 requests an hour per server, cached
# for an hour). A token only raises that limit; any fine-grained token with no permissions works.
# GITHUB_TOKEN=

# Sign-in (Auth.js), used only when NEXT_PUBLIC_SHELRA_APP=1.
# Secret used to sign the session cookie. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth app: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github (your domain in production)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client (Web application): https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (your domain in production)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email + password users live in a libSQL database. In development the default is a local file
# (.data/auth.db, created automatically). In production point it at a libSQL/Turso database:
# https://turso.tech (free tier) → URL libsql://<name>-<org>.turso.io + auth token.
AUTH_DATABASE_URL=
AUTH_DATABASE_TOKEN=

# Search (optional). The canonical origin defaults to https://www.shelra.dev; override it for another domain.
# NEXT_PUBLIC_SITE_URL=https://www.shelra.dev
# Search Console and Bing Webmaster verification tags, if you verify by meta tag instead of DNS:
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Outside Vercel (behind a trusted reverse proxy) also set:
# AUTH_TRUST_HOST=true
# AUTH_URL=https://your-domain.com
