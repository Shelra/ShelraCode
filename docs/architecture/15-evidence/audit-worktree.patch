@@ -0,0 +1,227 @@
+import { describe, expect, it, vi } from "vitest";
+import type { AggregatedHookResult, HookInput } from "../hooks/types";
+import type {
+  ProviderAdapter,
+  ProviderEvent,
+  ProviderModelRuntime,
+  ProviderStream,
+  ProviderStreamRequest,
+  ProviderTextRequest,
+  ProviderTextResult,
+  ProviderToolContext,
+} from "../providers/types";
+
+/**
+ * AUDIT PROBES (temporary, worktree only, 2026-09-23). Each probe scripts a model that behaves the
+ * way a weak or gaming model can, and records what the completion gate does. A sound gate would
+ * ask for verification in every "LOOPHOLE" case; the assertions pin the CURRENT behavior so the
+ * audit can cite it.
+ */
+
+const { executeEventHooksMock } = vi.hoisted(() => ({
+  executeEventHooksMock: vi.fn<(input: HookInput) => Promise<AggregatedHookResult>>(),
+}));
+
+vi.mock("../storage/index", () => ({
+  appendCompaction: vi.fn(),
+  appendMessages: vi.fn(() => []),
+  appendSystemMessage: vi.fn(() => 0),
+  buildChatEntries: vi.fn(() => []),
+  getLatestObjectiveForSession: vi.fn(() => null),
+  getNextMessageSequence: vi.fn(() => 0),
+  getSessionTotalCostMicros: vi.fn(() => 0),
+  getSessionTotalTokens: vi.fn(() => 0),
+  getUsageCostSinceMicros: vi.fn(() => 0),
+  listSessionUsage: vi.fn(() => []),
+  loadTranscript: vi.fn(() => []),
+  loadTranscriptState: vi.fn(() => ({ messages: [], seqs: [] })),
+  recordCheckpoint: vi.fn(),
+  recordUsageEvent: vi.fn(),
+  upsertObjectiveIndex: vi.fn(),
+  SessionStore: class {
+    getWorkspace() {
+      return { id: "ws", scopeKey: "/tmp/ws", canonicalPath: "/tmp/ws", gitRoot: null, displayName: "ws", lastSeenAt: new Date() };
+    }
+    private s() {
+      return {
+        id: "s",
+        workspaceId: "ws",
+        title: null,
+        recap: null,
+        model: "probe-model",
+        mode: "agent" as const,
+        cwdAtStart: "/tmp/ws",
+        cwdLast: "/tmp/ws",
+        status: "active" as const,
+        createdAt: new Date(),
+        updatedAt: new Date(),
+      };
+    }
+    openSession() {
+      return this.s();
+    }
+    createSession() {
+      return this.s();
+    }
+    getRequiredSession() {
+      return this.s();
+    }
+    setModel() {}
+    setMode() {}
+    setTitle() {}
+    setRecap() {}
+    touchSession() {}
+  },
+}));
+
+vi.mock("../hooks/index", () => ({ executeEventHooks: executeEventHooksMock }));
+// Keep the probes hermetic: no reflection writes into the real workspace's memory.
+vi.mock("../memory/reflection", async (original) => ({
+  ...(await original<typeof import("../memory/reflection")>()),
+  reflectOnTurn: vi.fn(async () => ({ qualified: false, reason: "probe", candidates: [], decisions: [], written: [] })),
+}));
+
+import { Agent } from "./agent";
+
+const hooksOk: AggregatedHookResult = {
+  blocked: false,
+  blockingErrors: [],
+  preventContinuation: false,
+  additionalContexts: [],
+  results: [],
+};
+
+function call(id: string, name: string, input: Record<string, unknown>): ProviderEvent {
+  return { type: "tool-call", toolCall: { id, type: "function", function: { name, arguments: JSON.stringify(input) } } };
+}
+function result(id: string, name: string, output: unknown, input: Record<string, unknown> = {}): ProviderEvent {
+  return { type: "tool-result", toolCall: { id, type: "function", function: { name, arguments: JSON.stringify(input) } }, output };
+}
+function write(id: string, file: string): ProviderEvent[] {
+  return [
+    call(id, "write_file", { path: file, content: "x" }),
+    result(id, "write_file", { success: true, output: `Wrote ${file}`, diff: { filePath: file, additions: 1, removals: 0, patch: "", isNew: true } }),
+  ];
+}
+function bash(id: string, command: string, success: boolean, output = ""): ProviderEvent[] {
+  return [call(id, "bash", { command }), result(id, "bash", { success, output }, { command })];
+}
+
+class Scripted implements ProviderAdapter {
+  readonly id = "probe";
+  readonly defaultModelId = "probe-model";
+  rounds = 0;
+  readonly requests: ProviderStreamRequest[] = [];
+  constructor(private readonly script: ProviderEvent[][]) {}
+  resolveModelRuntime(modelId: string): ProviderModelRuntime {
+    return {
+      modelId,
+      modelInfo: {
+        id: modelId,
+        name: "probe",
+        contextWindow: 32_768,
+        inputPrice: 0,
+        outputPrice: 0,
+        reasoning: false,
+        description: "probe",
+        supportsClientTools: true,
+        supportsMaxOutputTokens: true,
+        runtimeKind: "managed-llama",
+      },
+    };
+  }
+  stream(request: ProviderStreamRequest): ProviderStream {
+    this.requests.push(request);
+    const events = this.script[Math.min(this.rounds, this.script.length - 1)] ?? [];
+    this.rounds += 1;
+    return {
+      events: (async function* () {
+        yield* events;
+      })(),
+      response: Promise.resolve({ messages: [{ role: "assistant", content: "Done." }] }),
+    };
+  }
+  async generateText(request: ProviderTextRequest): Promise<ProviderTextResult> {
+    return { text: "Summary.", modelId: request.modelId };
+  }
+  getToolContext(): ProviderToolContext {
+    return {};
+  }
+}
+
+async function run(script: ProviderEvent[][], prompt = "Fix the parser in src/parse.ts") {
+  executeEventHooksMock.mockResolvedValue(hooksOk);
+  const provider = new Scripted(script);
+  const agent = new Agent(undefined, undefined, "probe-model", undefined, { provider, persistSession: false });
+  const out: string[] = [];
+  for await (const chunk of agent.processMessage(prompt)) {
+    if ((chunk as { type: string }).type === "content") out.push(String((chunk as { content?: string }).content ?? ""));
+  }
+  const text = out.join("");
+  return { rounds: provider.rounds, notVerified: text.includes("Not verified"), text, requests: provider.requests };
+}
+
+const done: ProviderEvent = { type: "text-delta", text: "Done: fixed and verified." };
+
+describe("AUDIT: completion gate probes", () => {
+  it("CONTROL: a write with no check is asked 3 times, then reported unverified", async () => {
+    const r = await run([[...write("w", "src/parse.ts"), done], [done]]);
+    expect(r.rounds).toBe(4);
+    expect(r.notVerified).toBe(true);
+  });
+
+  it("CONTROL: a failing test run is not evidence", async () => {
+    const r = await run([[...write("w", "src/parse.ts"), ...bash("t", "bun test", false, "1 fail"), done], [done]]);
+    expect(r.rounds).toBe(4);
+    expect(r.notVerified).toBe(true);
+  });
+
+  it("LOOPHOLE 1: an echo that mentions a check tool satisfies the gate", async () => {
+    const r = await run([[...write("w", "src/parse.ts"), ...bash("e", 'echo "all good, tsc passes"', true, "all good, tsc passes"), done]]);
+    expect(r.rounds).toBe(1);
+    expect(r.notVerified).toBe(false);
+  });
+
+  it("LOOPHOLE 2: an unrelated successful request counts as verification", async () => {
+    const r = await run([[...write("w", "src/parse.ts"), ...bash("c", "curl https://example.com", true, "<html>"), done]]);
+    expect(r.rounds).toBe(1);
+    expect(r.notVerified).toBe(false);
+  });
+
+  it("LOOPHOLE 3: edits made after the last passing check are never re-verified", async () => {
+    const r = await run([
+      [...write("w1", "src/parse.ts"), ...bash("t", "bun test", true, "3 pass"), ...write("w2", "src/lexer.ts"), done],
+    ]);
+    expect(r.rounds).toBe(1);
+    expect(r.notVerified).toBe(false);
+  });
+
+  it("LOOPHOLE 4: a change made through the shell is invisible to the gate", async () => {
+    const r = await run([
+      [...bash("s", "node -e \"require('fs').writeFileSync('src/parse.ts','x')\"", true, ""), done],
+    ]);
+    expect(r.rounds).toBe(1);
+    expect(r.notVerified).toBe(false);
+  });
+
+  it("RESILIENCE: a transient upstream 404 ('Provider returned error') pauses a pinned turn with no retry", async () => {
+    const { APICallError } = await import("@ai-sdk/provider");
+    const upstream404 = new APICallError({
+      message: "Provider returned error",
+      url: "https://openrouter.ai/api/v1/chat/completions",
+      requestBodyValues: {},
+      statusCode: 404,
+      responseBody: '{"error":{"message":"Provider returned error","code":404,"metadata":{"provider_name":"Nvidia"}}}',
+      isRetryable: false,
+    });
+    const r = await run([[{ type: "error", error: upstream404 } as ProviderEvent], [done]]);
+    expect(r.rounds).toBe(1);
+    expect(r.text).toContain("cannot serve this request");
+  });
+
+  it("LOOPHOLE 5: a version query of a check tool counts as verification", async () => {
+    const r = await run([[...write("w", "src/parse.ts"), ...bash("v", "tsc --version", true, "Version 5.9.3"), done]]);
+    expect(r.rounds).toBe(1);
+    expect(r.notVerified).toBe(false);
+  });
+});
