+  const request = provider.requests[0];
+  const tools = request?.tools ?? {};
+  const schemaChars = JSON.stringify(
+    Object.fromEntries(
+      Object.entries(tools).map(([name, definition]) => [
+        name,
+        { d: (definition as { description?: string }).description, s: (definition as { inputSchema?: unknown }).inputSchema },
+      ]),
+    ),
+  ).length;
+  return { systemChars: String(request?.system ?? "").length, toolCount: Object.keys(tools).length, schemaChars };
+}
+
+describe("AUDIT: request size", () => {
+  it("prints the fixed overhead of one request", async () => {
+    const empty = mkdtempSync(join(tmpdir(), "shelra-audit-empty-"));
+    const clean = await measure(empty);
+    const repoRoot = join(__dirname, "..", "..");
+    const inRepo = await measure(join(repoRoot, "bench", "fixtures", "shelra-agent-core-v0.2", "01-input-normalization"));
+    const agentsMd = loadCustomInstructions(join(repoRoot, "bench"))?.length ?? 0;
+    const skills = formatSkillsForPrompt(discoverSkills(join(repoRoot, "bench")))?.length ?? 0;
+    console.log(JSON.stringify({ clean, inRepo, inheritedAgentsMdChars: agentsMd, inheritedSkillsChars: skills }));
+    expect(clean.systemChars).toBeGreaterThan(0);
+  });
+});
diff --git a/src/bench/claude-code-executor.ts b/src/bench/claude-code-executor.ts
new file mode 100644
index 0000000..29a0517
--- /dev/null
+++ b/src/bench/claude-code-executor.ts
@@ -0,0 +1,322 @@
+import { spawn } from "node:child_process";
+import { mkdirSync } from "node:fs";
+import { join } from "node:path";
+import { VERIFICATION_COMMAND_RE } from "../agent/verification-evidence";
+import { evaluateAcceptance } from "../autonomy/acceptance";
+import type { AcceptanceCriterion, CheckSpec, VerificationReport } from "../autonomy/types";
+import { observePage } from "../exec/browser";
+import { runCommand } from "../exec/command";
+import { probeHttp } from "../exec/http";
+import type { BenchmarkExecutionNotice, BenchmarkTaskExecution } from "./runner";
+import { calculateIntentScore } from "./scoring";
+import type { BenchmarkAcceptanceResult, BenchmarkTaskDefinition } from "./types";
+
+/**
+ * AUDIT (worktree only, 2026-09-23): an external reference adapter. Runs Claude Code headless
+ * (`claude -p`) on the same task workspace the Shelra adapter gets, then grades the workspace with
+ * the same benchmark-owned oracle. The owner's user/project settings, plugins, hooks and MCP servers
+ * are not loaded; auto memory is redirected to a scratch folder; sessions are not persisted.
+ */
+
+export interface ClaudeCodeExecutorOptions {
+  model: string;
+  benchmarkRoot: string;
+  taskTimeoutMs?: number;
+  maxTurns?: number;
+  scratchDir: string;
+}
+
+interface StreamStats {
+  toolCalls: number;
+  bashCommands: string[];
+  verificationCommands: number;
+  failedToolResults: number;
+  filesChanged: Set<string>;
+  resultText: string;
+  numTurns: number | null;
+  costUsd: number | null;
+  inputTokens: number;
+  outputTokens: number;
+  cacheRead: number;
+  cacheCreate: number;
+  modelsUsed: string[];
+  isError: boolean;
+  subtype: string | null;
+}
+
+function childEnv(): NodeJS.ProcessEnv {
+  const env: NodeJS.ProcessEnv = { ...process.env };
+  for (const key of Object.keys(env)) {
+    if (key === "CLAUDECODE" || key === "CLAUDE_PID" || key.startsWith("CLAUDE_CODE_") || key === "ANTHROPIC_MODEL") {
+      delete env[key];
+    }
+  }
+  // The bench runs with a scratch HOME for Shelra's own database; Claude Code needs the real one for its login.
+  if (process.env.AUDIT_REAL_USERPROFILE) {
+    env.USERPROFILE = process.env.AUDIT_REAL_USERPROFILE;
+    env.HOME = process.env.AUDIT_REAL_USERPROFILE;
+  }
+  return env;
+}
+
+function parseStream(lines: string[]): StreamStats {
+  const stats: StreamStats = {
+    toolCalls: 0,
+    bashCommands: [],
+    verificationCommands: 0,
+    failedToolResults: 0,
+    filesChanged: new Set(),
+    resultText: "",
+    numTurns: null,
+    costUsd: null,
+    inputTokens: 0,
+    outputTokens: 0,
+    cacheRead: 0,
+    cacheCreate: 0,
+    modelsUsed: [],
+    isError: false,
+    subtype: null,
+  };
+  for (const line of lines) {
+    let event: Record<string, unknown>;
+    try {
+      event = JSON.parse(line) as Record<string, unknown>;
+    } catch {
+      continue;
+    }
+    const message = event.message as { content?: unknown } | undefined;
+    const content = Array.isArray(message?.content) ? (message?.content as Array<Record<string, unknown>>) : [];
+    if (event.type === "assistant") {
+      for (const block of content) {
+        if (block.type !== "tool_use") continue;
+        stats.toolCalls += 1;
+        const input = (block.input ?? {}) as Record<string, unknown>;
+        const name = String(block.name ?? "");
+        if ((name === "Bash" || name === "PowerShell") && typeof input.command === "string") {
+          stats.bashCommands.push(input.command);
+          if (VERIFICATION_COMMAND_RE.test(input.command)) stats.verificationCommands += 1;
+        }
+        if ((name === "Edit" || name === "Write" || name === "MultiEdit") && typeof input.file_path === "string") {
+          stats.filesChanged.add(input.file_path);
+        }
+      }
+    } else if (event.type === "user") {
+      for (const block of content) if (block.type === "tool_result" && block.is_error === true) stats.failedToolResults += 1;
+    } else if (event.type === "result") {
+      stats.resultText = typeof event.result === "string" ? event.result : "";
+      stats.numTurns = typeof event.num_turns === "number" ? event.num_turns : null;
+      stats.costUsd = typeof event.total_cost_usd === "number" ? event.total_cost_usd : null;
+      stats.isError = event.is_error === true;
+      stats.subtype = typeof event.subtype === "string" ? event.subtype : null;
+      const usage = (event.usage ?? {}) as Record<string, unknown>;
+      stats.inputTokens = Number(usage.input_tokens ?? 0);
+      stats.outputTokens = Number(usage.output_tokens ?? 0);
+      stats.cacheRead = Number(usage.cache_read_input_tokens ?? 0);
+      stats.cacheCreate = Number(usage.cache_creation_input_tokens ?? 0);
+      const modelUsage = event.modelUsage as Record<string, unknown> | undefined;
+      if (modelUsage) stats.modelsUsed = Object.keys(modelUsage);
+    }
+  }
+  return stats;
+}
+
+function runClaude(
+  prompt: string,
+  cwd: string,
+  options: ClaudeCodeExecutorOptions,
+  signal: AbortSignal,
+): Promise<{ lines: string[]; exitCode: number | null; stderr: string; timedOut: boolean }> {
+  const settings = JSON.stringify({ autoMemoryDirectory: join(options.scratchDir, "claude-auto-memory") });
+  const args = [
+    "-p",
+    "--model",
+    options.model,
+    "--output-format",
+    "stream-json",
+    "--verbose",
+    "--permission-mode",
+    "acceptEdits",
+    "--allowedTools",
+    "Bash",
+    "PowerShell",
+    "--max-turns",
+    String(options.maxTurns ?? 80),
+    "--no-session-persistence",
+    "--strict-mcp-config",
+    "--setting-sources",
+    "",
+    "--settings",
+    settings,
+  ];
+  return new Promise((resolve) => {
+    // No shell: cmd.exe drops the empty `--setting-sources ""` argument (seen 2026-09-23).
+    const child = spawn(process.env.AUDIT_CLAUDE_BIN || "claude", args, { cwd, env: childEnv(), windowsHide: true });
+    let buffer = "";
+    const lines: string[] = [];
+    let stderr = "";
+    let timedOut = false;
+    const timer = setTimeout(() => {
+      timedOut = true;
+      child.kill();
+    }, options.taskTimeoutMs ?? 20 * 60_000);
+    const onAbort = () => child.kill();
+    signal.addEventListener("abort", onAbort, { once: true });
+    child.stdout.on("data", (chunk: Buffer) => {
+      buffer += chunk.toString("utf8");
+      let index = buffer.indexOf("\n");
+      while (index >= 0) {
+        const line = buffer.slice(0, index).trim();
+        buffer = buffer.slice(index + 1);
+        if (line) lines.push(line);
+        index = buffer.indexOf("\n");
+      }
+    });
+    child.stderr.on("data", (chunk: Buffer) => {
+      stderr = `${stderr}${chunk.toString("utf8")}`.slice(-4_000);
+    });
+    child.on("close", (code) => {
+      clearTimeout(timer);
+      signal.removeEventListener("abort", onAbort);
+      if (buffer.trim()) lines.push(buffer.trim());
+      resolve({ lines, exitCode: code, stderr, timedOut });
+    });
+    child.on("error", (error) => {
+      stderr = `${stderr}\n${String(error)}`;
+    });
+    child.stdin.write(prompt);
+    child.stdin.end();
+  });
+}
+
+function toRuntimeCriteria(criteria: BenchmarkTaskDefinition["acceptanceCriteria"]): AcceptanceCriterion[] | undefined {
+  if (!criteria || criteria.length === 0 || criteria.some((criterion) => !criterion.check)) return undefined;
+  return criteria.map((criterion) => ({
+    id: criterion.id,
+    description: criterion.description,
+    required: criterion.required !== false,
+    check: { ...(criterion.check as CheckSpec) } as AcceptanceCriterion["check"],
+  }));
+}
+
+export function createClaudeCodeExecutor(options: ClaudeCodeExecutorOptions) {
+  mkdirSync(options.scratchDir, { recursive: true });
+  return {
+    async executeTask(
+      task: BenchmarkTaskDefinition,
+      context: { signal?: AbortSignal; emit: (notice: BenchmarkExecutionNotice) => void },
+    ): Promise<BenchmarkTaskExecution> {
+      const workspace = task.workspace ?? process.cwd();
+      const startedAt = Date.now();
+      const controller = new AbortController();
+      context.signal?.addEventListener("abort", () => controller.abort(), { once: true });
+      context.emit({ type: "note", taskId: task.id, message: `Claude Code turn started with ${options.model}`, payload: {} });
+      const run = await runClaude(task.prompt, workspace, options, controller.signal);
+      const stats = parseStream(run.lines);
+      const durationMs = Date.now() - startedAt;
+
+      const criteria = toRuntimeCriteria(task.acceptanceCriteria);
+      let report: VerificationReport | undefined;
+      if (criteria) {
+        report = await evaluateAcceptance(
+          criteria,
+          { workspace, benchmarkRoot: options.benchmarkRoot, attempt: 1, signal: context.signal },
+          {
+            runCommand: (command, commandOptions) =>
+              runCommand({
+                command,
+                cwd: commandOptions.cwd,
+                timeoutMs: commandOptions.timeoutMs,
+                signal: commandOptions.signal,
+                env: commandOptions.env,
+              }),
+            probeHttp: (url) => probeHttp(url),
+            observePage: (url, pageOptions) => observePage(url, pageOptions),
+          },
+        );
+      }
+      const byId = new Map((report?.results ?? []).map((result) => [result.id, result]));
+      const acceptance: BenchmarkAcceptanceResult[] = (task.acceptanceCriteria ?? []).map((criterion) => {
+        const result = byId.get(criterion.id);
+        return {
+          id: criterion.id,
+          description: criterion.description,
+          status: result ? (result.passed ? "passed" : "failed") : "not_run",
+          required: criterion.required !== false,
+          ...(result?.detail ? { detail: result.detail } : {}),
+        };
+      });
+      const required = acceptance.filter((criterion) => criterion.required !== false);
+      const passed = required.filter((criterion) => criterion.status === "passed").length;
+      const verified = required.length > 0 && passed === required.length;
+      const coding = required.length > 0 ? (passed / required.length) * 100 : undefined;
+      const intent = calculateIntentScore(acceptance);
+      return {
+        status: verified ? "passed" : "failed",
+        scores: {
+          ...(coding === undefined ? {} : { coding }),
+          ...(intent === undefined ? {} : { intent }),
+          verification: stats.verificationCommands > 0 ? 100 : 0,
+        },
+        tokens: {
+          inputTokens: stats.inputTokens + stats.cacheRead + stats.cacheCreate,
+          outputTokens: stats.outputTokens,
+          totalTokens: stats.inputTokens + stats.cacheRead + stats.cacheCreate + stats.outputTokens,
+        },
+        cost: {
+          micros: stats.costUsd === null ? null : Math.round(stats.costUsd * 1_000_000),
+          kind: "estimated",
+          source: "claude -p total_cost_usd (subscription; API-equivalent estimate)",
+        },
+        behavior: {
+          planCreated: false,
+          researchPerformed: false,
+          researchSources: 0,
+          delegatedAgents: 0,
+          llmCalls: stats.numTurns ?? 0,
+          toolCalls: stats.toolCalls,
+          commandsExecuted: stats.bashCommands.length,
+          filesRead: 0,
+          filesChanged: stats.filesChanged.size,
+          testsExecuted: stats.verificationCommands,
+          verificationAttempts: stats.verificationCommands,
+          failuresDetected: stats.failedToolResults,
+          repairsAttempted: 0,
+          repairsSucceeded: 0,
+          selfVerification: stats.verificationCommands > 0,
+          humanInterventions: 0,
+          completionBlocked: false,
+        },
+        acceptance,
+        finalResult: {
+          harness: "claude-code",
+          model: options.model,
+          modelsUsed: stats.modelsUsed,
+          numTurns: stats.numTurns,
+          costUsd: stats.costUsd,
+          exitCode: run.exitCode,
+          subtype: stats.subtype,
+          isError: stats.isError,
+          timedOut: run.timedOut,
+          verified,
+          stderrTail: run.stderr.slice(-400),
+          finalTextExcerpt: stats.resultText.trim().slice(-400),
+        },
+        failureReason: verified
+          ? null
+          : run.timedOut
+            ? "Claude Code exceeded the task timeout"
+            : `Benchmark acceptance criteria not satisfied: ${required
+                .filter((criterion) => criterion.status !== "passed")
+                .map((criterion) => criterion.id)
+                .join(", ")}`,
+        failureType: verified ? null : run.timedOut ? "timeout" : "intent_failure",
+        evidence: [{ kind: "other", path: workspace, label: "Graded task workspace" }],
+        durationMs,
+        llmDurationMs: null,
+        toolDurationMs: null,
+        verificationDurationMs: report?.durationMs ?? null,
+        repairDurationMs: null,
+      };
+    },
+  };
+}
diff --git a/src/bench/codex-executor.ts b/src/bench/codex-executor.ts
new file mode 100644
index 0000000..cda07be
--- /dev/null
+++ b/src/bench/codex-executor.ts
@@ -0,0 +1,253 @@
+import { spawn } from "node:child_process";
+import { mkdirSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { VERIFICATION_COMMAND_RE } from "../agent/verification-evidence";
+import { gradeWorkspace } from "./external-grading";
+import type { BenchmarkExecutionNotice, BenchmarkTaskExecution } from "./runner";
+import type { BenchmarkTaskDefinition } from "./types";
+
+/**
+ * AUDIT (worktree only, 2026-09-23): OpenAI Codex CLI as an external reference adapter. Runs
+ * `codex exec` non-interactively in the same task workspace with the owner's model and effort,
+ * a workspace-write sandbox and no persisted session, then grades with the same oracle.
+ */
+
+export interface CodexExecutorOptions {
+  model: string;
+  reasoningEffort: string;
+  benchmarkRoot: string;
+  scratchDir: string;
+  taskTimeoutMs?: number;
+}
+
+interface CodexStats {
+  commands: Array<{ command: string; exitCode: number | null }>;
+  verificationCommands: number;
+  failedCommands: number;
+  filesChanged: Set<string>;
+  agentMessages: string[];
+  itemCounts: Record<string, number>;
+  inputTokens: number;
+  cachedInputTokens: number;
+  outputTokens: number;
+  reasoningTokens: number;
+  turns: number;
+  errors: string[];
+}
+
+function childEnv(): NodeJS.ProcessEnv {
+  const env: NodeJS.ProcessEnv = { ...process.env };
+  if (process.env.AUDIT_REAL_USERPROFILE) {
+    env.USERPROFILE = process.env.AUDIT_REAL_USERPROFILE;
+    env.HOME = process.env.AUDIT_REAL_USERPROFILE;
+  }
+  return env;
+}
+
+function commandText(value: unknown): string {
+  if (typeof value === "string") return value;
+  if (Array.isArray(value)) return value.map(String).join(" ");
+  return "";
+}
+
+export function parseCodexEvents(lines: readonly string[]): CodexStats {
+  const stats: CodexStats = {
+    commands: [],
+    verificationCommands: 0,
+    failedCommands: 0,
+    filesChanged: new Set(),
+    agentMessages: [],
+    itemCounts: {},
+    inputTokens: 0,
+    cachedInputTokens: 0,
+    outputTokens: 0,
+    reasoningTokens: 0,
+    turns: 0,
+    errors: [],
+  };
+  for (const line of lines) {
+    let event: Record<string, unknown>;
+    try {
+      event = JSON.parse(line) as Record<string, unknown>;
+    } catch {
+      continue;
+    }
+    const type = String(event.type ?? "");
+    if (type === "turn.completed") {
+      stats.turns += 1;
+      const usage = (event.usage ?? {}) as Record<string, unknown>;
+      stats.inputTokens += Number(usage.input_tokens ?? 0);
+      stats.cachedInputTokens += Number(usage.cached_input_tokens ?? 0);
+      stats.outputTokens += Number(usage.output_tokens ?? 0);
+      stats.reasoningTokens += Number(usage.reasoning_output_tokens ?? usage.reasoning_tokens ?? 0);
+    } else if (type === "turn.failed" || type === "error") {
+      stats.errors.push(JSON.stringify(event.error ?? event.message ?? event).slice(0, 300));
+    } else if (type === "item.completed") {
+      const item = (event.item ?? {}) as Record<string, unknown>;
+      const itemType = String(item.type ?? item.item_type ?? "unknown");
+      stats.itemCounts[itemType] = (stats.itemCounts[itemType] ?? 0) + 1;
+      if (itemType === "command_execution") {
+        const command = commandText(item.command);
+        const exitCode = typeof item.exit_code === "number" ? item.exit_code : null;
+        stats.commands.push({ command, exitCode });
+        if (VERIFICATION_COMMAND_RE.test(command)) stats.verificationCommands += 1;
+        if (exitCode !== null && exitCode !== 0) stats.failedCommands += 1;
+      } else if (itemType === "file_change") {
+        for (const change of Array.isArray(item.changes) ? (item.changes as Array<Record<string, unknown>>) : []) {
+          if (typeof change.path === "string") stats.filesChanged.add(change.path);
+        }
+      } else if (itemType === "agent_message" && typeof item.text === "string") {
+        stats.agentMessages.push(item.text);
+      }
+    }
+  }
+  return stats;
+}
+
+function runCodex(
+  prompt: string,
+  cwd: string,
+  options: CodexExecutorOptions,
+  signal: AbortSignal,
+): Promise<{ lines: string[]; exitCode: number | null; stderr: string; timedOut: boolean }> {
+  const args = [
+    "exec",
+    "--json",
+    "--skip-git-repo-check",
+    "--ephemeral",
+    "-m",
+    options.model,
+    "-c",
+    `model_reasoning_effort="${options.reasoningEffort}"`,
+    "-s",
+    "workspace-write",
+    "-C",
+    cwd,
+    "-",
+  ];
+  return new Promise((resolve) => {
+    const child = spawn(process.env.AUDIT_CODEX_BIN || "codex", args, { cwd, env: childEnv(), windowsHide: true });
+    let buffer = "";
+    const lines: string[] = [];
+    let stderr = "";
+    let timedOut = false;
+    const timer = setTimeout(() => {
+      timedOut = true;
+      child.kill();
+    }, options.taskTimeoutMs ?? 20 * 60_000);
+    const onAbort = () => child.kill();
+    signal.addEventListener("abort", onAbort, { once: true });
+    child.stdout.on("data", (chunk: Buffer) => {
+      buffer += chunk.toString("utf8");
+      let index = buffer.indexOf("\n");
+      while (index >= 0) {
+        const line = buffer.slice(0, index).trim();
+        buffer = buffer.slice(index + 1);
+        if (line) lines.push(line);
+        index = buffer.indexOf("\n");
+      }
+    });
+    child.stderr.on("data", (chunk: Buffer) => {
+      stderr = `${stderr}${chunk.toString("utf8")}`.slice(-4_000);
+    });
+    child.on("close", (code) => {
+      clearTimeout(timer);
+      signal.removeEventListener("abort", onAbort);
+      if (buffer.trim()) lines.push(buffer.trim());
+      resolve({ lines, exitCode: code, stderr, timedOut });
+    });
+    child.on("error", (error) => {
+      stderr = `${stderr}\n${String(error)}`;
+    });
+    child.stdin.write(prompt);
+    child.stdin.end();
+  });
+}
+
+export function createCodexExecutor(options: CodexExecutorOptions) {
+  mkdirSync(join(options.scratchDir, "codex-transcripts"), { recursive: true });
+  return {
+    async executeTask(
+      task: BenchmarkTaskDefinition,
+      context: { signal?: AbortSignal; emit: (notice: BenchmarkExecutionNotice) => void },
+    ): Promise<BenchmarkTaskExecution> {
+      const workspace = task.workspace ?? process.cwd();
+      const startedAt = Date.now();
+      const controller = new AbortController();
+      context.signal?.addEventListener("abort", () => controller.abort(), { once: true });
+      context.emit({ type: "note", taskId: task.id, message: `Codex turn started with ${options.model}`, payload: {} });
+      const run = await runCodex(task.prompt, workspace, options, controller.signal);
+      const durationMs = Date.now() - startedAt;
+      try {
+        writeFileSync(
+          join(options.scratchDir, "codex-transcripts", `${task.id}-${startedAt}.jsonl`),
+          `${run.lines.join("\n")}\n`,
+        );
+      } catch {
+        // evidence only
+      }
+      const stats = parseCodexEvents(run.lines);
+      const graded = await gradeWorkspace(task, workspace, options.benchmarkRoot, context.signal);
+      return {
+        status: graded.verified ? "passed" : "failed",
+        scores: {
+          ...(graded.coding === undefined ? {} : { coding: graded.coding }),
+          ...(graded.intent === undefined ? {} : { intent: graded.intent }),
+          verification: stats.verificationCommands > 0 ? 100 : 0,
+        },
+        tokens: {
+          inputTokens: stats.inputTokens,
+          outputTokens: stats.outputTokens,
+          totalTokens: stats.inputTokens + stats.outputTokens,
+          cachedTokens: stats.cachedInputTokens,
+          reasoningTokens: stats.reasoningTokens,
+        },
+        cost: { micros: null, kind: "unavailable", source: "ChatGPT plan usage; Codex exec reports tokens only" },
+        behavior: {
+          planCreated: false,
+          researchPerformed: false,
+          researchSources: 0,
+          delegatedAgents: 0,
+          llmCalls: stats.turns,
+          toolCalls: Object.values(stats.itemCounts).reduce((sum, value) => sum + value, 0),
+          commandsExecuted: stats.commands.length,
+          filesRead: 0,
+          filesChanged: stats.filesChanged.size,
+          testsExecuted: stats.verificationCommands,
+          verificationAttempts: stats.verificationCommands,
+          failuresDetected: stats.failedCommands,
+          repairsAttempted: 0,
+          repairsSucceeded: 0,
+          selfVerification: stats.verificationCommands > 0,
+          humanInterventions: 0,
+          completionBlocked: false,
+        },
+        acceptance: graded.acceptance,
+        finalResult: {
+          harness: "codex",
+          model: options.model,
+          reasoningEffort: options.reasoningEffort,
+          exitCode: run.exitCode,
+          timedOut: run.timedOut,
+          verified: graded.verified,
+          itemCounts: stats.itemCounts,
+          errors: stats.errors,
+          stderrTail: run.stderr.slice(-400),
+          finalTextExcerpt: (stats.agentMessages.at(-1) ?? "").trim().slice(-400),
+        },
+        failureReason: graded.verified
+          ? null
+          : run.timedOut
+            ? "Codex exceeded the task timeout"
+            : `Benchmark acceptance criteria not satisfied: ${graded.failedIds.join(", ")}`,
+        failureType: graded.verified ? null : run.timedOut ? "timeout" : "intent_failure",
+        evidence: [{ kind: "other", path: workspace, label: "Graded task workspace" }],
+        durationMs,
+        llmDurationMs: null,
+        toolDurationMs: null,
+        verificationDurationMs: graded.report?.durationMs ?? null,
+        repairDurationMs: null,
+      };
+    },
+  };
+}
diff --git a/src/bench/external-grading.ts b/src/bench/external-grading.ts
new file mode 100644
index 0000000..da78d5d
--- /dev/null
+++ b/src/bench/external-grading.ts
@@ -0,0 +1,70 @@
+import { evaluateAcceptance } from "../autonomy/acceptance";
+import type { AcceptanceCriterion, CheckSpec, VerificationReport } from "../autonomy/types";
+import { observePage } from "../exec/browser";
+import { runCommand } from "../exec/command";
+import { probeHttp } from "../exec/http";
+import { calculateIntentScore } from "./scoring";
+import type { BenchmarkAcceptanceResult, BenchmarkTaskDefinition } from "./types";
+
+/** AUDIT (worktree only): grades an external agent's workspace with the benchmark-owned oracle. */
+export async function gradeWorkspace(
+  task: BenchmarkTaskDefinition,
+  workspace: string,
+  benchmarkRoot: string,
+  signal?: AbortSignal,
+): Promise<{
+  acceptance: BenchmarkAcceptanceResult[];
+  verified: boolean;
+  coding?: number;
+  intent?: number;
+  report?: VerificationReport;
+  failedIds: string[];
+}> {
+  const criteria = task.acceptanceCriteria;
+  let report: VerificationReport | undefined;
+  if (criteria && criteria.length > 0 && criteria.every((criterion) => criterion.check)) {
+    const runtime: AcceptanceCriterion[] = criteria.map((criterion) => ({
+      id: criterion.id,
+      description: criterion.description,
+      required: criterion.required !== false,
+      check: { ...(criterion.check as CheckSpec) } as AcceptanceCriterion["check"],
+    }));
+    report = await evaluateAcceptance(
+      runtime,
+      { workspace, benchmarkRoot, attempt: 1, signal },
+      {
+        runCommand: (command, commandOptions) =>
+          runCommand({
+            command,
+            cwd: commandOptions.cwd,
+            timeoutMs: commandOptions.timeoutMs,
+            signal: commandOptions.signal,
+            env: commandOptions.env,
+          }),
+        probeHttp: (url) => probeHttp(url),
+        observePage: (url, pageOptions) => observePage(url, pageOptions),
+      },
+    );
+  }
+  const byId = new Map((report?.results ?? []).map((result) => [result.id, result]));
+  const acceptance: BenchmarkAcceptanceResult[] = (criteria ?? []).map((criterion) => {
+    const result = byId.get(criterion.id);
+    return {
+      id: criterion.id,
+      description: criterion.description,
+      status: result ? (result.passed ? "passed" : "failed") : "not_run",
+      required: criterion.required !== false,
+      ...(result?.detail ? { detail: result.detail } : {}),
+    };
+  });
+  const required = acceptance.filter((criterion) => criterion.required !== false);
+  const passed = required.filter((criterion) => criterion.status === "passed").length;
+  return {
+    acceptance,
+    verified: required.length > 0 && passed === required.length,
+    ...(required.length > 0 ? { coding: (passed / required.length) * 100 } : {}),
+    ...(calculateIntentScore(acceptance) === undefined ? {} : { intent: calculateIntentScore(acceptance) }),
+    ...(report ? { report } : {}),
+    failedIds: required.filter((criterion) => criterion.status !== "passed").map((criterion) => criterion.id),
+  };
+}
