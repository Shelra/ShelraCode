# Shelra environment configuration (all values optional)
# --------------------------------------------------------------------------
# Shelra is cloud-first. With an OpenRouter key it starts in Free cloud mode.
# The managed GGUF coding model remains available explicitly with
# `shelra --local` for private/offline inference and runs through llama.cpp.
#
# Copy this file to `.env` and set only the values you need.

# --- Optional remote provider ---------------------------------------------
# Optional generic OpenAI-compatible endpoint. OpenRouter is the default cloud
# provider when `OPENROUTER_API_KEY` is configured.
# SHELRA_API_KEY=your_provider_api_key
# SHELRA_BASE_URL=https://api.your-provider.example/v1

# Native OpenRouter integration. This key activates cloud-first Free mode and
# defaults to https://openrouter.ai/api/v1.
# OPENROUTER_API_KEY=sk-or-v1-...
# Optional conservative spend limits for remote model calls.
# SHELRA_MAX_SESSION_COST_USD=0
# SHELRA_MAX_REQUEST_COST_USD=0

# Guardrails for a model/provider that stops responding. The idle timeout is
# the maximum silence between streamed chunks; increase it for slow local
# models, but keep it finite so a frozen turn can recover. Values are ms.
# Hitting any of them interrupts the round, never the turn: completed steps are
# kept, the round is retried, and a model that keeps failing is replaced by a
# fallback (see SHELRA_FALLBACK_MODELS).
# SHELRA_MODEL_TIMEOUT_MS=900000       # 15 minutes per complete turn
# SHELRA_MODEL_STEP_TIMEOUT_MS=300000  # 5 minutes per model/tool step
# SHELRA_MODEL_IDLE_TIMEOUT_MS=90000   # 90 seconds without a stream chunk
# SHELRA_MCP_TIMEOUT_MS=20000          # MCP connect/tools discovery

# Models a turn continues with, in order, when the selected one stops answering, runs out of
# credits or budget, or has no endpoint. They may be paid; the switch notice states the cost.
# Default for OpenRouter: its own router for the spending policy (--model-policy): free and a
# hand-chosen model -> openrouter/free; auto/economy/balanced/quality/max -> openrouter/auto
# (billed at the model it picks, bounded by the policy's cost tier), then openrouter/free.
# SHELRA_FALLBACK_MODELS=openrouter/free

# Provider stream diagnostics: 1 traces stream parts (finish reasons, tool calls) to stderr;
# 2 additionally tees raw response bodies. Use when a model step ends with no visible output.
# SHELRA_DEBUG_STREAM=1

# Idle budget for a model stream: when no part arrives for this long (ms) the request is
# aborted and the step retried instead of waiting on a silent upstream. 0 disables. Default 180000.
# SHELRA_STREAM_IDLE_MS=180000

# Web research provider chain (docs/architecture/14-AGENT-HARNESS-RECONSTRUCTION.md §9). Without
# any of these, Shelra still researches via Google's public results page and then DuckDuckGo
# HTML — no key required, unchanged default. Configure any of the below to use a real search
# API instead of HTML scraping; Tavily is tried first when set.
#
# Tavily — real free tier (1,000 credits/mo, no card). Preferred default when configured.
# TAVILY_API_KEY=tvly-...
#
# Google Custom Search JSON API — closed to new signups and sunsetting 2027-01-01; only useful
# if you already have a key from before that closure.
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=
#
# Exa — alternative/fallback provider (not a guaranteed "better for docs" router; that's a
# community claim, not an Exa-documented guarantee).
# EXA_API_KEY=
#
# SearXNG — point at an already-running instance you self-host or trust; Shelra never bundles
# SearXNG's own (AGPL) source, only calls its HTTP JSON API.
# SEARXNG_BASE_URL=https://searx.example.com
#
# Brave Search API — lowest priority; Brave now requires a card even on its free tier, so this
# is opt-in only, never a default.
# BRAVE_SEARCH_API_KEY=

# Force a specific model id for every turn (absolute override).
# SHELRA_MODEL=

# Cap on output tokens per response.
# SHELRA_MAX_TOKENS=

# --- Telegram bridge ----------------------------------------------------------
# Token from @BotFather. Enables `/connect` → Telegram remote control.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# --- Advanced: local runtime tuning ----------------------------------------
# Backend for the managed llama.cpp engine. Auto-detected from the host
# (CUDA when an NVIDIA GPU is present); set to override.
# SHELRA_RUNTIME_BACKEND=cpu   # or: cuda

# Context window handed to the local server. Defaults are bounded per backend
# so a spec-sized window cannot OOM a small machine.
# SHELRA_CONTEXT=8192
# SHELRA_GPU_CONTEXT=16384

# Use an already-running OpenAI-compatible local server (LM Studio, llama.cpp,
# Ollama, ...) instead of the managed engine.
# SHELRA_LOCAL_ENDPOINT=http://127.0.0.1:1234/v1

# Model id the first-run recommender should install.
# SHELRA_ONBOARDING_MODEL=

# Never download/install the managed runtime automatically.
# SHELRA_DISABLE_RUNTIME_INSTALL=1

# Sandbox is opt-in only (`--sandbox`). No workspace trust prompt is shown.

KEY_GROQ=
KEY_OPENROUTER=
